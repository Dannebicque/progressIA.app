# Copy this file to .env.prod.local on the production VPS.
# Never commit .env.prod.local.

APP_ENV=prod
APP_DEBUG=0
APP_SECRET=change-me
DEFAULT_URI=https://api.progressia.app

# The database must be reachable from the shared_internal Docker network.
# Do not hard-code serverVersion here: the production MariaDB server can be
# upgraded independently and Doctrine DBAL must detect the actual vendor/version.
DATABASE_URL=mysql://USER:PASSWORD@DATABASE_HOST:3306/progressia?charset=utf8mb4

CORS_ALLOW_ORIGIN='^https://progressia\.app$'

JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=change-me

MAILER_DSN=null://null
